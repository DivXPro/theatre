{
  "name": "theatre-monorepo",
  "license": "Apache-2.0",
  "version": "0.7.0",
  "scripts": {
    "cli": "tsx devEnv/cli.ts",
    "playground": "pnpm --filter playground run serve",
    "benchmarks": "pnpm --filter benchmarks run serve",
    "sync-server": "pnpm --filter @dreamerbird/sync-server run cli dev start",
    "test:e2e": "pnpm --filter playground run test",
    "test:e2e:ci": "pnpm --filter playground run test:ci",
    "typecheck": "pnpm run build:ts",
    "build:ts": "tsc --build ./devEnv/typecheck-all-projects/tsconfig.all.json",
    "test": "jest",
    "test:compat:install": "pnpm --filter @dreamerbird/compat-tests run install-fixtures",
    "test:compat:run": "jest --config jest.compat-tests.config.js",
    "postinstall": "husky install && pnpm --filter @dreamerbird/app exec prisma generate && pnpm --filter @dreamerbird/sync-server exec prisma generate",
    "lint:all": "eslint . --ext ts,tsx --ignore-path=.gitignore --rulesdir ./devEnv/eslint/rules"
  },
  "lint-staged": {
    "(theatre|packages|devEnv|compat-tests)/**/*.(t|j)s?(x)": [
      "eslint --rulesdir ./devEnv/eslint/rules --fix"
    ],
    "**/*.(t|j)s?(x)": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cspotcode/zx": "^6.1.2",
    "@microsoft/api-documenter": "^7.19.0",
    "@microsoft/api-extractor": "^7.28.6",
    "@types/eslint": "^8.56.0",
    "@types/jest": "^26.0.23",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "esbuild": "^0.18.18",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-tsdoc": "^0.2.17",
    "eslint-plugin-unused-imports": "^3.0.0",
    "fast-glob": "^3.3.0",
    "husky": "^6.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "jest-esbuild": "^0.3.0",
    "jsonc-parser": "^3.1.0",
    "knip": "^3.9.0",
    "lint-staged": "^13.0.3",
    "lodash": "^4.17.21",
    "node-gyp": "^9.1.0",
    "prettier": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sade": "^1.8.1",
    "tsx": "4.7.0",
    "typescript": "5.6.3",
    "yaml": "^2.3.1"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@actions/core": "^1.10.0"
  }
}
