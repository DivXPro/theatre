{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "rootDir": "src",
    "types": [
      "jest",
      "node"
    ],
    "emitDeclarationOnly": true,
    "composite": true,
    "checkJs": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/studio"
    }
  ],
  "include": [
    "./src/**/*"
  ]
}
