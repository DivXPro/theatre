#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

pnpm lint-staged
pnpm --filter @dreamerbird/dataverse run precommit

# if there are unstaged changes in ./packages/dataverse/docs, fail
if ! git diff --quiet --exit-code -- docs; then
  echo "Please run 'pnpm --filter @dreamerbird/dataverse run doc' and commit the changes to the docs folder"
  exit 1
fi
