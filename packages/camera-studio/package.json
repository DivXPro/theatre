{
  "name": "@dreamerbird/camera-studio",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract-tests": {
      "types": "./dist/assetLibrary/contractTests.d.ts",
      "default": "./dist/assetLibrary/contractTests.js"
    }
  },
  "files": [
    "dist/**/*",
    "assets/**/*"
  ],
  "scripts": {
    "build:ts": "tsc -b tsconfig.json",
    "build:api": "tsc -b tsconfig.json && api-extractor run --local --config devEnv/api-extractor.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@dreamerbird/core": "*",
    "@dreamerbird/studio": "*",
    "@react-three/fiber": "^9.0.0",
    "react": ">=19",
    "react-dom": ">=19",
    "three": ">=0.185"
  },
  "dependencies": {
    "@dreamerbird/dataverse": "workspace:*",
    "@dreamerbird/r3f": "workspace:*",
    "@dreamerbird/react": "workspace:*",
    "@dreamerbird/threeik": "0.2.1",
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/extensions": "^4.0.0",
    "@gltf-transform/functions": "^4.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "draco3dgltf": "^1.5.7",
    "styled-components": "^6.5.3",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.28.6",
    "@react-three/fiber": "^9.7.0",
    "@types/jest": "^26.0.23",
    "@types/node": "^15.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "fake-indexeddb": "^5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "typescript": "5.6.3"
  }
}
