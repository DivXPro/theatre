{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".temp/declarations",
    "lib": ["es2017", "dom", "ESNext"],
    "rootDir": ".",
    "composite": true,
    "types": ["jest", "node"],
    "emitDeclarationOnly": true,
    // paths 在派生 tsconfig 里是全量替换(不合并),@dreamerbird/* 段照抄
    // tsconfig.base.json;react 钉版的原因见 camera-studio/tsconfig.json
    // 的同名注释(pnpm 布局下第三方 d.ts 上爬抓错主版本)。
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"],
      "@dreamerbird/camera-studio": ["../../packages/camera-studio/src/index.ts"],
      "@dreamerbird/camera-studio/contract-tests": ["../../packages/camera-studio/src/assetLibrary/contractTests.ts"],
      "@dreamerbird/camera-studio/*": ["../../packages/camera-studio/src/*"],
      "@dreamerbird/core": ["../../packages/core/src/index.ts"],
      "@dreamerbird/core/*": ["../../packages/core/src/*"],
      "@dreamerbird/studio": ["../../packages/studio/src/index.ts"],
      "@dreamerbird/studio/*": ["../../packages/studio/src/*"],
      "@dreamerbird/utils": ["../../packages/utils/src/index.ts"],
      "@dreamerbird/utils/*": ["../../packages/utils/src/*"],
      "@dreamerbird/saaz": ["../../packages/saaz/src/index.ts"],
      "@dreamerbird/app/*": ["../../packages/app/src/*"],
      "@dreamerbird/sync-server/*": ["../../packages/sync-server/src/*"],
      "@dreamerbird/dataverse": ["../../packages/dataverse/src/index.ts"],
      "@dreamerbird/react": ["../../packages/react/src/index.ts"],
      "@dreamerbird/r3f": ["../../packages/r3f/src/index.ts"],
      "@dreamerbird/r3f/dist/extension": ["../../packages/r3f/src/extension/index.ts"],
      "@dreamerbird/dataverse-experiments": [
        "../../packages/dataverse-experiments/src/index.ts"
      ],
      "@dreamerbird/theatric": ["../../packages/theatric/src/index.ts"]
    },
    "plugins": [
      {
        "name": "@styled/typescript-styled-plugin",
        "lint": {
          "unknownProperties": "ignore"
        }
      }
    ]
  },
  "references": [
    {"path": "../core"},
    {"path": "../utils"},
    {"path": "../dataverse"},
    {"path": "../react"},
    {"path": "../app"},
    {"path": "../sync-server"},
    {"path": "../saaz"}
  ],
  "include": [
    "../core/globals.d.ts",
    "./globals.d.ts",
    "./src/**/*",
    "./devEnv/**/*"
  ],
  "exclude": ["**/node_modules", "**/.*", "**/xeno", "**/dist", "**/.temp"]
}
