{
  "name": "playground",
  "version": "1.0.0-dev",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "serve": "vite",
    "serve:ci": "vite build && vite preview",
    "build": "vite build --force",
    "build:static": "echo 'building for vercel' && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --config=devEnv/playwright.config.ts",
    "test:ci": "playwright test --reporter=dot --config=devEnv/playwright.config.ts --project=chromium"
  },
  "devDependencies": {
    "@dreamerbird/core": "workspace:*",
    "@dreamerbird/dataverse": "workspace:*",
    "@dreamerbird/r3f": "workspace:*",
    "@dreamerbird/react": "workspace:*",
    "@dreamerbird/studio": "workspace:*",
    "@dreamerbird/theatric": "workspace:*",
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/extensions": "^4.0.0",
    "@gltf-transform/functions": "^4.0.0",
    "@playwright/test": "^1.36.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/jest": "^26.0.23",
    "@types/lodash-es": "^4.17.4",
    "@types/node": "^15.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "dotenv": "^16.3.1",
    "draco3dgltf": "^1.5.7",
    "fake-indexeddb": "^5",
    "fast-glob": "^3.3.0",
    "lodash-es": "^4.17.21",
    "maath": "^0.10.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-components": "^6.5.3",
    "three": "^0.185.1",
    "typescript": "5.6.3",
    "vite": "^4.3.9"
  },
  "private": true,
  "dependencies": {
    "@dreamerbird/camera-studio": "workspace:*",
    "@dreamerbird/threeik": "0.2.1",
    "@phosphor-icons/react": "^2.1.10"
  }
}
