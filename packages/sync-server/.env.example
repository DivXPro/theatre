# Self-hosted minimal loop (no app, no postgres): AUTH_DISABLED=true
AUTH_DISABLED=true
HOST=localhost
PORT=3001
NODE_ENV=development

# App-backed mode (auth on) additionally requires:
# DATABASE_URL=postgresql://postgres:test@localhost:43943/postgres
# APP_URL=http://localhost:3000
# DEV_DB_PORT=43943
# DEV_DB_PASSWORD=test
